# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION:
# Connect your Supabase project instance (https://supabase.com)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# STRIPE CHECKOUT & WEBHOOKS (Server-side only — never expose in client code):
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"

# GUMROAD DIGITAL PRODUCT & WEBHOOK INTEGRATION (Server-side only — never expose in client code):
GUMROAD_ACCESS_TOKEN="your_gumroad_oauth_or_api_access_token"
# Set GUMROAD_WEBHOOK_SECRET for header-authenticated pings OR GUMROAD_SELLER_ID for native Gumroad Ping verification:
GUMROAD_WEBHOOK_SECRET="optional_secret_token_for_gumroad_ping_url"
GUMROAD_SELLER_ID="your_gumroad_seller_id"

# PROVENANCE, GOVERNANCE & ORIGIN HARDENING (Server-side only — NEVER use VITE_ prefix):
# Generate 256-bit random secrets (e.g. `openssl rand -hex 32`)
PROVENANCE_ACTIVE_KEY_ID="ingest-key-2026-11"
PROVENANCE_HMAC_KEYS='{"ingest-key-2026-11":{"secret":"replace_with_32_byte_random_hex_secret","status":"active","allowedComponent":"nexus-ingestion-api","expiresAt":"2027-02-01T00:00:00.000Z"}}'
# Optional single-key fallback instead of PROVENANCE_HMAC_KEYS:
# PROVENANCE_HMAC_SECRET="replace_with_32_byte_random_hex_secret"
# Comma-separated owner Supabase Auth UUIDs & approved production app origins:
GOVERNANCE_OWNER_USER_IDS=""
ALLOWED_APP_ORIGINS="https://your-production-domain.example"
ALLOW_LOCALHOST_ORIGINS="false"
GOVERNANCE_REQUEST_TTL_MS="3600000"
GOVERNANCE_APPROVAL_TTL_MS="900000"
# Persistent Postgres RPC replay backend (required in production):
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your_service_role_secret"
# PROVENANCE_REPLAY_DB_PATH=".data/provenance-replay.sqlite"

